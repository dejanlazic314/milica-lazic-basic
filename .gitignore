# Private repo (deploy notes, design, Claude notes) – separate git repository
/private/

# Claude Code entry point – only imports files from /private/
/CLAUDE.md

# Local environment and secrets
.env.local
.env.*.local
*.local.md

# Contao / Symfony (generated or content, never in git)
/bin/
/vendor/
/var/
/assets/
/files/
/system/
/contao-manager/

# public/ is generated by contao-setup; only our layout assets are tracked
/public/*
!/public/layout/

# Tools
/node_modules/
/test-results/
/playwright-report/

# OS / editor
.DS_Store
Thumbs.db
/.vscode/sftp.json

# DDEV: password file for the shared link (.ddev/nginx/share-auth.conf)
.ddev/share.htpasswd
