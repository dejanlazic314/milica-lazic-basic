{#
    Heading + grid of nested cards. Markup: html/strane/pocetna.html (<div id="kako" class="how">)
    Set the anchor ID (e.g. "kako") in the element's CSS ID field.
#}
{% extends '@Contao/content_element/_base.html.twig' %}

{% set attributes = attrs(attributes|default).addClass(variant) %}

{% block inner %}
    {% if title %}<h3>{{ title }}</h3>{% endif %}
    <div class="grid grid--3-tablet">
        {% for fragment in nested_fragments %}
            {{ content_element(fragment) }}
        {% endfor %}
    </div>
{% endblock %}
