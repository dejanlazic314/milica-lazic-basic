{#
    Generic subpage section. Markup: html/strane/tema-*.html, o-meni.html,
    online-terapija.html and kontakt.html (one block per layout below).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% trans_default_domain 'site' %}

{% set attributes = attrs(attributes|default)
    .addClass('section')
    .addClass(style ? 'section--' ~ style : [])
    .addClass(spacing[0] ?: [])
    .setIfExists('style', spacing[1])
%}

{% block wrapper_tag %}section{% endblock %}

{% macro head(eyebrow, title, lead) %}
    {%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif -%}
    {%- if title %}<h2 class="h2-page">{{ title }}</h2>{% endif -%}
    {%- if lead %}<p>{{ lead }}</p>{% endif -%}
{% endmacro %}

{% block inner %}
    {% set rich %}{{ text|sanitize_html('contao')|encode_email|insert_tag_raw }}{% endset %}
    <div class="content {{ content_class }}">
        {% block layout %}
            {% if layout == 'split' %}
                {# Heading on the left, the text and the nested elements on the right #}
                <div class="split__head">{{ _self.head(eyebrow, title, lead) }}</div>
                <div class="split__body">{{ rich }}
                    {%- for fragment in nested_fragments %}{{ content_element(fragment) }}{% endfor -%}
                </div>

            {% elseif layout == 'columns' %}
                {# Two columns: heading, text and the nested elements on the left; on the right the map,
                   or without a map the last nested element #}
                {% set right = map.embed ? null : nested_fragments|last %}
                <div class="columns__text">{{ _self.head(eyebrow, title, lead) }}{{ rich }}
                    {%- for fragment in (right ? nested_fragments|slice(0, -1) : nested_fragments) %}{{ content_element(fragment) }}{% endfor -%}
                </div>
                {% if right %}{{ content_element(right) }}{% endif %}
                {% if map.embed %}
                    <div class="map-consent map-consent--large" data-map data-src="{{ map.embed }}">
                        <div class="map-consent__message">
                            <p><strong>{{ 'map.off'|trans }}</strong> {{ 'map.off_text'|trans }}</p>
                            <div class="actions"><button class="btn btn-dark btn-small" type="button" data-map-show>{{ 'map.show'|trans }}</button>
                                {%- if map.link %}<a class="link-arrow" href="{{ map.link }}" target="_blank" rel="noopener">{{ 'map.open'|trans }}</a>{% endif -%}
                            </div>
                        </div></div>
                {% endif %}

            {% else %}
                {% if title or lead %}
                    <div class="head head--wide">{{ _self.head(eyebrow, title, lead) }}</div>
                {% elseif eyebrow %}
                    <p class="eyebrow">{{ eyebrow }}</p>
                {% endif %}
                {{ rich }}
                {% for fragment in nested_fragments %}{{ content_element(fragment) }}{% endfor %}
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}

{# The layout's own CSS (elements/section-<layout>.css) and that of extra classes, see SectionController #}
{% block style %}
    {{ parent() }}
    {%- for name in extra_assets %}{% do add_assets(name) %}{% endfor -%}
{% endblock %}
