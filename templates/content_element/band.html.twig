{#
    Band. Markup: html/strane/pocetna.html (#online, .online-band) and the end of
    subpages, e.g. html/strane/tema.html (.cta-band).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_picture.html.twig' %}

{% set attributes = attrs(attributes|default)
    .addClass('section')
    .addClass('section--no-top', variant == 'cta')
%}

{% block wrapper_tag %}section{% endblock %}

{% block wrapper %}
    {%- if spacer %}<div style="height:var(--section-small)"></div>{% endif -%}
    {{ parent() }}
{% endblock %}

{% block inner %}
    <div class="content {{ variant == 'online' ? 'online-band' : 'cta-band' }}">
        {% if variant == 'online' and ornament %}
            {% with {figure: ornament, img_attributes: attrs().addClass('online-band__ornament').set('alt', '').set('loading', 'lazy')} %}
                {{ block('picture_component') }}
            {% endwith %}
        {% endif %}
        <div class="{{ variant == 'online' ? 'online-band__text' : 'cta-band__text' }}">
            <h2{{ variant == 'cta' ? ' class="h2-page"' }}>{{ title }}</h2>
            {% if text %}<p>{{ text }}</p>{% endif %}
        </div>
        {% if button.href and button.text %}
            <a class="{{ variant == 'online' ? 'btn btn-outline' : 'btn btn-darkest btn-large' }}" href="{{ button.href|insert_tag }}">{{ button.text }}</a>
        {% endif %}
    </div>
{% endblock %}
