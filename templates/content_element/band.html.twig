{#
    Band: white with a branch drawing (html/strane/pocetna.html, #online, .online-band) or
    apricot at the end of subpages (e.g. html/strane/tema.html, .cta-band).
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_picture.html.twig' %}

{% set attributes = attrs(attributes|default)
    .addClass('section')
    .addClass('section--no-top', variant == 'apricot')
%}

{% block wrapper_tag %}section{% endblock %}

{% block wrapper %}
    {%- if spacer %}<div style="height:var(--section-small)"></div>{% endif -%}
    {{ parent() }}
{% endblock %}

{% block inner %}
    <div class="content band band--{{ variant }}">
        {% if variant == 'white' and ornament %}
            {% with {figure: ornament, img_attributes: attrs().addClass('band__ornament').set('alt', '').set('loading', 'lazy')} %}
                {{ block('picture_component') }}
            {% endwith %}
        {% endif %}
        <div class="band__text">
            <h2{{ variant == 'apricot' ? ' class="h2-page"' }}>{{ title }}</h2>
            {% if text %}<p>{{ text }}</p>{% endif %}
        </div>
        {% if button.href and button.text %}
            <a class="{{ variant == 'white' ? 'btn btn-outline' : 'btn btn-darkest btn-large' }}" href="{{ button.href|insert_tag }}">{{ button.text }}</a>
        {% endif %}
    </div>
{% endblock %}
