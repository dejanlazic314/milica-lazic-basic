{#
    Card in a card group. Markup: html/strane/pocetna.html (.how__card)
#}
{% extends '@Contao/content_element/_base.html.twig' %}
{% import '@Contao/component/_icon.html.twig' as icons %}

{% set attributes = attrs(attributes|default).addClass('how__card') %}

{% block inner %}
    {% if icon %}<span class="how__icon">{{ icons.icon(icon) }}</span>{% endif %}
    <h4>{{ title }}</h4>
    {% if text %}<p>{{ text }}</p>{% endif %}
{% endblock %}
