{#
    Element "hero": the top block of a page. Markup: component/_hero.html.twig.
#}
{% extends '@Contao/content_element/_base.html.twig' %}

{% block wrapper %}
    {% embed '@Contao/component/_hero.html.twig' %}
        {% block hero_extra %}
            {% for fragment in nested_fragments %}
                {{ content_element(fragment) }}
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% endblock %}
