{% extends '@Contao/page/layout.html.twig' %}
{% trans_default_domain 'site' %}

{#
    Page layout for all pages (Contao "modern" layout type).
    Slots are filled with modules in the backend: Themes → Layouts → Modules.
    Markup follows private/dizajn/milica-lazic-start/html/strane/*.html.
#}

{#
    Stylesheets in public/layout/css/, loaded on every page in this order (later wins).
    base: tokens and plain HTML · layout: page structure, header, footer ·
    components: pieces used in many places · sections: one file per content element or page ·
    states.css: hover, pressed and focus for all of the above.
    sections/exercise.css is added only where the exercise is (content_element/exercise).
#}
{% set stylesheets = [
    'base/fonts', 'base/tokens', 'base/base',
    'layout/page',
    'components/typography', 'components/buttons', 'components/cards', 'components/icons',
    'components/accordion', 'components/summary', 'components/breadcrumb', 'components/bio',
    'components/reveal', 'components/form', 'components/cookies', 'components/map-consent',
    'components/circles', 'components/post-card',
    'layout/header', 'layout/mobile-menu',
    'sections/hero', 'sections/topics', 'sections/gestalt', 'sections/about', 'sections/band',
    'sections/faq', 'sections/posts', 'sections/quote-photo', 'sections/contact',
    'sections/page-intro', 'sections/topic-page', 'sections/about-page', 'sections/article',
    'sections/online-page', 'sections/error-404', 'sections/legal',
    'layout/footer',
    'states',
] %}
{# Scripts in public/layout/js/ (ES modules, run after the page is parsed, like defer).
   accordion.js, exercise.js and form.js are added only where they are needed. #}
{% set scripts = ['header', 'reveal', 'circles', 'cookies'] %}

{% block head %}
    {{ parent() }}
    {# Fonts used above the fold on every page. Plain URL without ?v=, it must
       match the url() in fonts.css or the font is downloaded twice. #}
    {% for font in ['inter', 'cormorant-garamond'] %}
        <link rel="preload" href="/layout/fonts/{{ font }}.woff2" as="font" type="font/woff2" crossorigin>
    {% endfor %}
    {% for name in stylesheets %}
        <link rel="stylesheet" href="{{ asset('layout/css/' ~ name ~ '.css') }}">
    {% endfor %}
    {# Translations of this page (src/Language/LanguageSwitcher.php); Serbian is the default #}
    {% set translations = language_alternates()|filter(alt => alt.translated) %}
    {% if translations|length > 1 %}
        {% for alt in translations %}
            <link rel="alternate" hreflang="{{ alt.language }}" href="{{ alt.url }}">
        {% endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ translations|first.url }}">
    {% endif %}
{% endblock %}

{% block body_content %}
    {# IDs stay Serbian: they are URL anchors (#sadrzaj, #kontakt, #vezba) #}
    <a class="skip-link" href="#sadrzaj">{{ 'layout.skip'|trans }}</a>

    {% slot header %}
        {{ slot() }}
    {% endslot %}

    <main id="sadrzaj">
        {% slot main %}{{ slot() }}{% endslot %}
    </main>

    {# Header and footer modules render their own <header>/<footer> markup #}
    {% slot footer %}
        {{ slot() }}
    {% endslot %}

    {% include '@Contao/component/_cookie_banner.html.twig' %}

    {% for name in scripts %}
        <script type="module" src="{{ asset('layout/js/' ~ name ~ '.js') }}"></script>
    {% endfor %}
{% endblock %}
