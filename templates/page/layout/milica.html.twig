{% extends '@Contao/page/layout.html.twig' %}
{% trans_default_domain 'site' %}

{#
    Page layout for all pages (Contao "modern" layout type).
    Slots are filled with modules in the backend: Themes → Layouts → Modules.
    Markup follows private/dizajn/milica-lazic-start/html/strane/*.html.
#}

{#
    CSS and JS on every page (public/layout/css/, public/layout/js/). Everything else comes
    with the element that needs it: a content element loads elements/<type>.css and .js
    (content_element/_base.html.twig), included parts and modules load their own files
    with add_assets(). The cascade order is fixed by layers (base/layers.css), not by the
    order of the files. The cookie banner is included here, after the <head>, so its files
    are in this list.
#}
{% set stylesheets = [
    'base/layers', 'base/fonts', 'base/tokens', 'base/base',
    'layout/page', 'layout/header', 'layout/mobile-menu', 'layout/footer',
    'components/typography', 'components/buttons', 'components/cards', 'components/icons',
    'components/reveal', 'components/filter', 'components/cookies',
] %}
{% set scripts = ['layout/header', 'components/reveal', 'components/cookies'] %}

{% block head %}
    {{ parent() }}
    {# Icons from the design (assets/logo). /favicon.ico for browsers that do not read SVG;
       theme-color is --sage-700, the manifest cannot read CSS custom properties. #}
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="{{ asset('layout/favicon/favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('layout/favicon/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('layout/favicon/site.webmanifest') }}">
    <meta name="theme-color" content="#4a5d43">
    {# Translations of this page (src/Language/LanguageSwitcher.php); Serbian is the default #}
    {% set translations = language_alternates()|filter(alt => alt.translated) %}
    {% if translations|length > 1 %}
        {% for alt in translations %}
            <link rel="alternate" hreflang="{{ alt.language }}" href="{{ alt.url }}">
        {% endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ translations|first.url }}">
    {% endif %}
{% endblock %}

{# Before the CSS the elements add (parent): base/layers.css must be the first stylesheet #}
{% block end_of_head %}
    {# Fonts used above the fold on every page. Plain URL without ?v=, it must
       match the url() in fonts.css or the font is downloaded twice. #}
    {% for font in ['inter', 'cormorant-garamond'] %}
        <link rel="preload" href="/layout/fonts/{{ font }}.woff2" as="font" type="font/woff2" crossorigin>
    {% endfor %}
    {% for name in stylesheets %}
        <link rel="stylesheet" href="{{ asset('layout/css/' ~ name ~ '.css') }}">
    {% endfor %}
    {{ parent() }}
{% endblock %}

{% block body_content %}
    {# IDs stay Serbian: they are URL anchors (#sadrzaj, #kontakt, #vezba) #}
    <a class="skip-link" href="#sadrzaj">{{ 'layout.skip'|trans }}</a>

    {% slot header %}
        {{ slot() }}
    {% endslot %}

    <main id="sadrzaj">
        {% slot main %}{{ slot() }}{% endslot %}
    </main>

    {# Header and footer modules render their own <header>/<footer> markup #}
    {% slot footer %}
        {{ slot() }}
    {% endslot %}

    {% include '@Contao/component/_cookie_banner.html.twig' %}

    {% for name in scripts %}
        <script type="module" src="{{ asset('layout/js/' ~ name ~ '.js') }}"></script>
    {% endfor %}
{% endblock %}
